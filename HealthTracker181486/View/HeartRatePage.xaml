<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker181486.View.HeartRatePage"
             xmlns:local="clr-namespace:HealthTracker181486.Resources.Services"
             Title="Heart Rate"
             Shell.TitleColor="white"
             Shell.ForegroundColor="white"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Set goal" Order="Secondary" Clicked="OnMenuClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,16" Spacing="12">
            
            <!-- Time Range Selector -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="8,4">
                <Border x:Name="HoursTab" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26" BackgroundColor="#3A3A3C">
                    <Label x:Name="HoursLabel" Text="Hours" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="0" Tapped="OnTabTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="DaysTab" Grid.Column="1" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26">
                    <Label x:Name="DaysLabel" Text="Days" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#8E8E93"/>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="1" Tapped="OnTabTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="WeeksTab" Grid.Column="2" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26">
                    <Label x:Name="WeeksLabel" Text="Weeks" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#8E8E93"/>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="2" Tapped="OnTabTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="MonthsTab" Grid.Column="3" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26">
                    <Label x:Name="MonthsLabel" Text="Months" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#8E8E93"/>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="3" Tapped="OnTabTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>



            <!-- Heart Rate -->
            <Border Style="{StaticResource Tile}" BackgroundColor="{StaticResource BackgroundLight}">
                <VerticalStackLayout Spacing="4" Padding="8" VerticalOptions="Center">
                    <Grid RowDefinitions="*,*">
                        <Label Text="Heart Rate Range" FontSize="20" HorizontalOptions="Start" TextColor="white"/>
                        <Label Grid.Row="1" Text="46-114 bpm" FontSize="29" TextColor="white" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tile}" HeightRequest="240" BackgroundColor="{StaticResource BackgroundLight}">

                <GraphicsView Grid.Row="1">
                    <GraphicsView.Drawable>
                        <local:HeartRateDrawable/>
                    </GraphicsView.Drawable>
                </GraphicsView>


            </Border>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>