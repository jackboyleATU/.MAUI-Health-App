<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker181486.View.Goals"
             Title="Goals"
             Shell.TitleColor="white"
             Shell.ForegroundColor="white"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="{StaticResource BackgroundLight}" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Today" TextColor="#B5B3B8" FontSize="15" />
                        <Label Text="1 of 3 goals met" TextColor="white" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Grid Grid.Column="1">
                        <Ellipse WidthRequest="80" HeightRequest="80" Stroke="#2A3318" StrokeThickness="8" />
                        <Ellipse WidthRequest="80" HeightRequest="80" Stroke="LimeGreen" StrokeThickness="8" StrokeLineCap="Round" StrokeDashArray="10,30" Rotation="-90"/>
                        <Label Text="33%" TextColor="white" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Label Text="Daily Goals" TextColor="#B5B3B8" FontSize="16" Margin="12,8,0,0" />
            
            <!-- Steps -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="{StaticResource BackgroundLight}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="walking.png" WidthRequest="32" HeightRequest="32" />
                        <Label Grid.Column="1" Text="Steps" TextColor="white" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="3592/6000" TextColor="#B5B3B8" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                    <Grid>
                        <Border HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#2A3318" />
                        <Grid ColumnDefinitions="60*, 40*">
                            <Border HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="LimeGreen" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Steps" Tapped="OnGoalTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Calories -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="{StaticResource BackgroundLight}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="fire.png" WidthRequest="32" HeightRequest="32" />
                        <Label Grid.Column="1" Text="Calories burned" TextColor="white" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="272/600" TextColor="#B5B3B8" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                    <Grid>
                        <Border HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#470000" />
                        <Grid ColumnDefinitions="45*, 55*">
                            <Border HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#D10000" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Calories" Tapped="OnGoalTapped" />
                </Border.GestureRecognizers>
            </Border>

            
            <!-- Calories -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="{StaticResource BackgroundLight}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="moon.png" WidthRequest="32" HeightRequest="32" />
                        <Label Grid.Column="1" Text="Sleep" TextColor="white" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="7h 24m / 7h" TextColor="LimeGreen" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                    <Grid>
                        <Border HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#7B61FF" />
                    </Grid>
                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="Sleep" Tapped="OnGoalTapped" />
                </Border.GestureRecognizers>
            </Border>


        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>