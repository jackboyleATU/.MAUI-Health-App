<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker181486.View.SetGoal"
             Title="Set Goal"
             Shell.TitleColor="white"
             Shell.ForegroundColor="white"
             BackgroundColor="{StaticResource Background}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border StrokeThickness="2" Stroke="#313131" StrokeShape="RoundRectangle 28" BackgroundColor="{StaticResource BackgroundLight}" Padding="20">
                <VerticalStackLayout>

                    <Label Text="Goal" TextColor="#B5B3B8" FontSize="14" Margin="4,0,0,4" />
                    <Border x:Name="TypeBox" StrokeThickness="1" Stroke="#3A3A3C" StrokeShape="RoundRectangle 14" BackgroundColor="#2A2A2C" Padding="12,0" HeightRequest="52">
                        <Picker x:Name="TypePicker" Title="Choose a goal" TextColor="White" TitleColor="#6E6E73" FontSize="18" VerticalOptions="Center" SelectedIndexChanged="OnTypeChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Steps</x:String>
                                    <x:String>Calories</x:String>
                                    <x:String>Sleep</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                    <Label x:Name="TypeError" Text="Please choose a goal" TextColor="#FF5C5C" FontSize="13" Margin="4,4,0,0" IsVisible="False" />

                    <Label Text="Target" TextColor="#B5B3B8" FontSize="14" Margin="4,16,0,4" />
                    <Border x:Name="TargetBox" StrokeThickness="1" Stroke="#3A3A3C" StrokeShape="RoundRectangle 14" BackgroundColor="#2A2A2C" Padding="12,0" HeightRequest="52">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="TargetEntry" Keyboard="Numeric" Placeholder="Enter a target" TextColor="White" PlaceholderColor="#6E6E73" FontSize="18" VerticalOptions="Center" />
                            <Label x:Name="UnitLabel" Grid.Column="1" Text="" TextColor="#B5B3B8" FontSize="16" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label x:Name="TargetError" TextColor="#FF5C5C" FontSize="13" Margin="4,4,0,0" IsVisible="False" />

                    <Label x:Name="HintLabel" Text="Choose a goal to see the allowed range" TextColor="#6E6E73" FontSize="13" Margin="4,8,0,0" />

                    <Grid ColumnDefinitions="*,Auto" Margin="4,20,0,0">
                        <Label Text="Daily reminder" TextColor="White" FontSize="18" VerticalOptions="Center" />
                        <Switch Grid.Column="1" OnColor="#4F9249" IsToggled="True" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save goal" HeightRequest="56" CornerRadius="28" FontSize="18" BackgroundColor="#4F9249" TextColor="white" Clicked="OnSaveClicked" />
            <Button Text="Cancel" HeightRequest="56" CornerRadius="28" FontSize="18" BackgroundColor="#3A3A3C" TextColor="white" Clicked="OnCancelClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>