<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker181486.View.About"
             Title="About"
             Shell.TitleColor="white"
             Shell.ForegroundColor="white"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- App Info -->
            <VerticalStackLayout Spacing="6" Margin="0,12,0,8">
                <Border WidthRequest="96" HeightRequest="96" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="#4F9249" HorizontalOptions="Center">
                    <Image Source="heart.png" WidthRequest="56" HeightRequest="56" />
                </Border>
                <Label Text="Health App" TextColor="White" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,8,0,0" />
                <Label Text="Version 1.0.0 (wireframe prototype)" TextColor="#8E8E93" HorizontalOptions="Center" />
            </VerticalStackLayout>
            
            <!-- Description -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Label TextColor="#B5B3B8" FontSize="15" LineHeight="1.3" Text="Health App helps you track your steps, calories, sleep, heart rate and workouts. Set goals, record exercises and see how your habits change over time." />
            </Border>
            
            <!-- Developer Info-->
            <Label Text="Developer" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" HeightRequest="56">
                        <Label Text="Name" Style="{StaticResource InfoName}" />
                        <Label Grid.Column="1" Text="Jack Boyle" Style="{StaticResource InfoValue}" />
                        <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" HeightRequest="56">
                        <Label Text="Student Number" Style="{StaticResource InfoName}" />
                        <Label Grid.Column="1" Text="L00181486" Style="{StaticResource InfoValue}" />
                        <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" HeightRequest="56">
                        <Label Text="Module" Style="{StaticResource InfoName}" />
                        <Label Grid.Column="1" Text="Cross Platform Development" Style="{StaticResource InfoValue}" />
                        <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" HeightRequest="56">
                        <Label Text="College" Style="{StaticResource InfoName}" />
                        <Label Grid.Column="1" Text="ATU Letterkenny" Style="{StaticResource InfoValue}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            
            <Label Text="Built with" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" HeightRequest="56">
                        <Label Text="Framework" Style="{StaticResource InfoName}" />
                        <Label Grid.Column="1" Text=".NET MAUI (.NET 10)" Style="{StaticResource InfoValue}" />
                        <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" HeightRequest="56">
                        <Label Text="Platforms" Style="{StaticResource InfoName}" />
                        <Label Grid.Column="1" Text="Android, Windows" Style="{StaticResource InfoValue}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="This app is not a medical device. Always consult a healthcare professional before making any health-related decisions." TextColor="#6E6E73" FontSize="13" HorizontalTextAlignment="Center" Margin="16,8,16,16" />
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>