<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker181486.View.AddExercise"
             Title="Start Exercise"
             Shell.TitleColor="white"
             Shell.ForegroundColor="white"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="{StaticResource BackgroundLight}" Padding="8,4">
            <VerticalStackLayout>

                <Grid ColumnDefinitions="72,*" HeightRequest="76">
                    <Image Source="walking.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Walking" TextColor="White" FontSize="22" VerticalOptions="Center"/>
                    <BoxView Grid.Column="1" HeightRequest="1" Color="#3A3A3A" Margin="0,0,16,0" VerticalOptions="End"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="Walking" Tapped="OnExerciseTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid ColumnDefinitions="72,*" HeightRequest="76">
                    <Image Source="running.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Running" TextColor="White" FontSize="22" VerticalOptions="Center"/>
                    <BoxView Grid.Column="1" HeightRequest="1" Color="#3A3A3A" Margin="0,0,16,0" VerticalOptions="End"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="Running" Tapped="OnExerciseTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid ColumnDefinitions="72,*" HeightRequest="76">
                    <Image Source="bike.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Cycling" TextColor="White" FontSize="22" VerticalOptions="Center"/>
                    <BoxView Grid.Column="1" HeightRequest="1" Color="#3A3A3A" Margin="0,0,16,0" VerticalOptions="End"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="Cycling" Tapped="OnExerciseTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid ColumnDefinitions="72,*" HeightRequest="76">
                    <Image Source="football.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Football" TextColor="White" FontSize="22" VerticalOptions="Center"/>
                    <BoxView Grid.Column="1" HeightRequest="1" Color="#3A3A3A" Margin="0,0,16,0" VerticalOptions="End"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="Football" Tapped="OnExerciseTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid ColumnDefinitions="72,*" HeightRequest="76">
                    <Image Source="workout.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Workout" TextColor="White" FontSize="22" VerticalOptions="Center"/>
                    <BoxView Grid.Column="1" HeightRequest="1" Color="#3A3A3A" Margin="0,0,16,0" VerticalOptions="End"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="Workout" Tapped="OnExerciseTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </ScrollView>
    
</ContentPage>