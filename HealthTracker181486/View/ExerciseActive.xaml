<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker181486.View.ExerciseActive"
             Title="Begin Exercise"
             Shell.TitleColor="white"
             Shell.ForegroundColor="white"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto" Padding="16,0,16,32">

        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="TimeLabel" Text="00:00" TextColor="white" FontSize="64" />
                <Label x:Name="Hundredths" Text=".00" TextColor="LightGray" FontSize="28" />
            </HorizontalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="24">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="48">
                <Button x:Name="ResetButton" Text="Reset" WidthRequest="96" HeightRequest="96" CornerRadius="48" BackgroundColor="#646368" TextColor="White" FontSize="18" IsEnabled="False" Opacity="0.4" Clicked="OnResetClicked" />
                <Button x:Name="StartPauseButton" Text="Start" WidthRequest="96" HeightRequest="96" CornerRadius="48" BackgroundColor="#4F9249" TextColor="White" FontSize="18" Clicked="OnStartPauseClicked" />
            </HorizontalStackLayout>

            <Button Text="Finish" HeightRequest="56" CornerRadius="28" BackgroundColor="#3A3A3C" TextColor="White" FontSize="18" Clicked="OnFinishClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>