<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthTracker181486.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HealthTracker181486"
    xmlns:view="clr-namespace:HealthTracker181486.View"
    Title="HealthTracker181486"
    Shell.BackgroundColor="{StaticResource Background}"
    Shell.TabBarBackgroundColor="{StaticResource BackgroundLight}"
    Shell.TabBarForegroundColor="white"
    Shell.TabBarTitleColor="white"
    Shell.TabBarUnselectedColor="LightGray">
    
    

    <!--<ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />-->

    <TabBar>
        <Tab Title="Dashboard" Icon="dashboard.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
        
        <Tab Title="Activity" Icon="activity.png">
            <ShellContent
                Title="Activity"
                ContentTemplate="{DataTemplate view:Activity}"
                Route="ActivityPage" />
        </Tab>
        
        <Tab Title="Trends" Icon="trend.png">
            <ShellContent
                Title="Trends"
                ContentTemplate="{DataTemplate view:Trends}"
                Route="TrendsPage" />
        </Tab>
        
        <Tab Title="Goals" Icon="goal.png">
            <ShellContent
                Title="Goals"
                ContentTemplate="{DataTemplate view:Goals}"
                Route="GoalsPage" />
        </Tab>
    </TabBar>

</Shell>
